# ==============================================================================
# CLINOVA AI — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Security Notice:
# NEVER commit actual production secrets, passwords, or tokens to version control.
# Copy this file to '.env' inside the 'backend' folder or pass these environment
# variables directly into your hosting provider dashboard (e.g., Render, Railway).
# ==============================================================================

# Application Metadata
APP_NAME="Clinova AI"
APP_VERSION="2.0.0"
ENVIRONMENT=production
DEBUG=false
API_V1_STR="/api/v1"
DEFAULT_FACILITY="Government District Hospital"

# Network & Server (0.0.0.0 required on containerized / cloud hosting)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# PORT is automatically injected by platforms like Render, Cloud Run, Heroku.
# PORT=8000

# Allowed CORS Origins (Comma-separated or JSON list of deployed frontend URLs)
# Include your deployed Vercel domain and any trusted custom domains
CORS_ORIGINS=https://clinova-ai.vercel.app,http://localhost:3000

# Database Persistence
# In production, provide a managed PostgreSQL connection string:
# Supported formats: postgresql+asyncpg://user:pass@host:5432/dbname or postgresql://...
# Example (Supabase / Render / Neon):
DATABASE_URL=postgresql+asyncpg://postgres:YourSecurePassword@db.yourproject.supabase.co:5432/postgres
# For local dev / test zero-install SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./clinova-dev.db

# Security & Authentication (MANDATORY IN PRODUCTION: 32+ high-entropy characters)
SECRET_KEY=generate-a-secure-random-32-char-key-for-production!
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256
DEMO_USER_PASSWORD=ChangeThisDemoPasswordInProduction!

# Legacy Development Flags (MUST BE FALSE IN PRODUCTION)
ALLOW_LEGACY_ACTOR_HEADERS=false
ALLOW_LEGACY_ANONYMOUS_FALLBACK=false

# Clinical Safety & Operation Governance
DEMO_MODE=true
OFFLINE_MODE=false
SYNTHETIC_DATA_ONLY=true
ANONYMIZATION_ENABLED=true
AUDIT_LOGGING_ENABLED=true
DATA_RETENTION_HOURS=24

# Document Upload & Storage Path
UPLOAD_DIR=storage/documents

# Local AI Runtime Configuration
# MOCK_DETERMINISTIC keeps test/cloud free tier zero-cost and hermetic.
# LOCAL_OLLAMA can be used when deployed on dedicated edge hardware with local Ollama.
AI_PROVIDER_MODE=MOCK_DETERMINISTIC
AI_RUNTIME_ENDPOINT=http://127.0.0.1:11434
AI_MODEL_ID=qwen3-4b-instruct
AI_TIMEOUT_SECONDS=5.0
