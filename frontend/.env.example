# ==============================================================================
# CLINOVA AI — FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Security Notice:
# All variables starting with NEXT_PUBLIC_ are bundled into client-side JavaScript
# and are visible to anyone inspecting browser network traffic or source bundles.
#
# NEVER EXPOSE:
# - Database URLs or credentials
# - Backend JWT SECRET_KEY
# - Cloud provider service keys or admin tokens
# ==============================================================================

# Public API Base URL
# Points to the deployed FastAPI backend (with or without /api/v1 suffix; auto-normalized)
# Both NEXT_PUBLIC_API_BASE_URL and NEXT_PUBLIC_API_URL are supported.
# Example for production (Render / Cloud Run):
NEXT_PUBLIC_API_URL=https://clinova-backend.onrender.com/api/v1
# NEXT_PUBLIC_API_BASE_URL=https://clinova-backend.onrender.com
# Example for local development:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Public Application Domain
# Used for canonical metadata and OpenGraph URL resolution
# Example for production (Vercel):
NEXT_PUBLIC_APP_URL=https://clinova-ai.vercel.app
# Example for local development:
# NEXT_PUBLIC_APP_URL=http://localhost:3000
