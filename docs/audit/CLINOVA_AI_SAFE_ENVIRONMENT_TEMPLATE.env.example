# ==============================================================================
# CLINOVA AI — SAFE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# WARNING: NEVER COMMIT ACTUAL API KEYS OR SECRETS TO VERSION CONTROL.
# Copy this file to '.env' at the repository root and fill in local credentials.
# Values in this template are safe placeholders only.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
APP_ENV=development
DEBUG=True
PROJECT_NAME="Clinova AI"
API_V1_STR=/api/v1
SECRET_KEY=clinova-insecure-dev-secret-key-change-in-production-min-32-chars-long!
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# 2. LOCAL SERVER & NETWORKING (NATIVE WINDOWS)
# ------------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3001
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Native PostgreSQL connection:
DATABASE_URL=postgresql+asyncpg://clinova_user:clinova_password@localhost:5432/clinova_db
# Zero-install SQLite fallback (activated automatically if PostgreSQL unavailable):
# DATABASE_URL=sqlite+aiosqlite:///./clinova-demo.db

# ------------------------------------------------------------------------------
# 4. CACHE & BACKGROUND QUEUE (REDIS)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# In-memory fallback is automatically engaged if Redis service is unreachable.

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE (LOCAL ENCRYPTED OR S3-COMPATIBLE)
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/documents
STORAGE_ENCRYPTION_KEY=clinova-storage-encryption-key-32-bytes-min!

# ------------------------------------------------------------------------------
# 6. EXTERNAL AI PROVIDER INTERFACES (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Free-first policy active: OFFLINE_DEMO=True disables external network API calls
OFFLINE_DEMO=True

# Google Gemini (Temporary baseline / decision support copilot)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Sarvam AI (Indic STT, Translation, TTS candidate)
SARVAM_API_KEY=

# Groq (Whisper STT fallback / open reasoning model baseline candidate)
GROQ_API_KEY=

# OCR.Space (Free-tier OCR candidate)
OCR_SPACE_API_KEY=

# ------------------------------------------------------------------------------
# 7. CLINICAL SAFETY & BOUNDARIES
# ------------------------------------------------------------------------------
STRICT_CLINICAL_BOUNDARIES=True
AUDIT_LOG_ALL_REQUESTS=True
EMERGENCY_ESCALATION_ENABLED=True
MAX_ATTACHMENT_SIZE_MB=10
