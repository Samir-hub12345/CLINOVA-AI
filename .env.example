# ==============================================================================
# CLINOVA AI — UNIFIED SYSTEM ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Security Notice:
# NEVER commit actual secrets, passwords, or production keys to version control.
# Copy this template to '.env' at the repository root for native local execution,
# or configure the corresponding variables in your cloud hosting provider dashboards.
# ==============================================================================

# ==============================================================================
# 1. BACKEND SERVICE CONFIGURATION (FastAPI on Render / Container)
# ==============================================================================
APP_NAME="Clinova AI"
APP_VERSION="2.0.0"
ENVIRONMENT=production
DEBUG=false
API_V1_STR="/api/v1"
DEFAULT_FACILITY="Government District Hospital"

# Server Network Binding (0.0.0.0 required on cloud containers)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# PORT is automatically injected by cloud providers like Render
# PORT=8000

# CORS Allowed Origins (Comma-separated list of deployed frontend URLs)
CORS_ORIGINS=https://clinova-ai.vercel.app,http://localhost:3000

# Database Connection (PostgreSQL on Supabase / Render / Neon)
# Supported: postgresql+asyncpg://... or postgresql://...
DATABASE_URL=postgresql+asyncpg://postgres:YourSecurePassword@db.yourproject.supabase.co:5432/postgres

# Authentication & Cryptographic Security (MANDATORY: 32+ characters)
SECRET_KEY=generate-a-secure-random-32-char-key-for-production!
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256
DEMO_USER_PASSWORD=ChangeThisDemoPasswordInProduction!

# Legacy Flags (MUST BE FALSE IN PRODUCTION)
ALLOW_LEGACY_ACTOR_HEADERS=false
ALLOW_LEGACY_ANONYMOUS_FALLBACK=false

# Clinical Safety & Operation Governance
DEMO_MODE=true
OFFLINE_MODE=false
SYNTHETIC_DATA_ONLY=true
ANONYMIZATION_ENABLED=true
AUDIT_LOGGING_ENABLED=true
DATA_RETENTION_HOURS=24

# Document Storage & Uploads
UPLOAD_DIR=storage/documents

# Local AI Runtime
AI_PROVIDER_MODE=MOCK_DETERMINISTIC
AI_RUNTIME_ENDPOINT=http://127.0.0.1:11434
AI_MODEL_ID=qwen3-4b-instruct
AI_TIMEOUT_SECONDS=5.0

# ==============================================================================
# 2. FRONTEND SERVICE CONFIGURATION (Next.js on Vercel)
# ==============================================================================
# These variables are exposed to client-side browser JavaScript.
# NEVER include database credentials or JWT SECRET_KEY here.
NEXT_PUBLIC_API_URL=https://clinova-backend.onrender.com/api/v1
NEXT_PUBLIC_APP_URL=https://clinova-ai.vercel.app
