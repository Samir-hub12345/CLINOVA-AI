# ==============================================================================
# CLINOVA AI - Environment Configuration Template
# Continuous Care Intelligence Architecture (CareGraph, FacilityGraph, SignalGraph, Orchestration)
# ==============================================================================

# === APPLICATION ===
APP_NAME="Clinova AI"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
DEFAULT_FACILITY="Government District Hospital"

# === NETWORKING & HOSTS ===
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="Clinova AI"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# === DATABASE & PERSISTENCE ===
# SQLite for local development:
DATABASE_URL=sqlite+aiosqlite:///./clinova-dev.db
# PostgreSQL for production / multi-user deployment:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clinova

# === CACHING & REALTIME (OPTIONAL) ===
REDIS_URL=redis://localhost:6379/0

# === CLINICAL SAFETY & PRIVACY ===
DEMO_MODE=True
OFFLINE_MODE=True
SYNTHETIC_DATA_ONLY=True
ANONYMIZATION_ENABLED=True
AUDIT_LOGGING_ENABLED=True
DATA_RETENTION_HOURS=24

# === SECURITY ===
SECRET_KEY=change-this-in-production-to-a-secure-random-64-char-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === INTELLIGENCE PROVIDERS (PLUGGABLE / OPTIONAL) ===
# All AI operations remain advisory, non-diagnostic, and human-in-the-loop.
# The system operates fully offline with deterministic rules when no keys are provided.
AI_PROVIDER=local_rules
GEMINI_API_KEY=
GROQ_API_KEY=
SARVAM_API_KEY=
OCR_SPACE_API_KEY=
