# ==============================================================================
# CLINOVA AI - Environment Configuration Template
# Safe default placeholders for native Windows development and production.
# ==============================================================================

# === APPLICATION ===
APP_NAME="Clinova AI"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
DEFAULT_FACILITY="Government District Hospital"

# === DATABASE ===
# Native Windows PostgreSQL:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clinova
# Zero-Install Local SQLite Alternative:
# DATABASE_URL=sqlite+aiosqlite:///./clinova-demo.db

# === REDIS ===
# Native Windows Redis / Memurai:
REDIS_URL=redis://localhost:6379/0
# Note: If Redis is not running, Clinova gracefully falls back to in-memory mode.

# === FRONTEND ===
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="Clinova AI"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]

# === BACKEND ===
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# === AI ===
# Google Gemini 2.5 Flash API Key (Server-side only; never expose to frontend)
# If left empty, Clinova automatically falls back to deterministic clinical rules.
GEMINI_API_KEY=
LLM_PROVIDER=mock
DEMO_MODE=True
OFFLINE_DEMO=False

# === OCR ===
OCR_PROVIDER=local

# === STT ===
STT_PROVIDER=local

# === TRANSLATION ===
TRANSLATION_PROVIDER=local

# === SECURITY ===
# Generate a cryptographically secure 64-character secret in production
SECRET_KEY=change-this-in-production-to-a-secure-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === OPTIONAL SERVICES ===
STORAGE_PROVIDER=local_object_store
STORAGE_LOCAL_DIR=storage_data
STORAGE_BUCKET=medical-documents
MAX_FILE_SIZE_BYTES=524288000
PRESIGNED_URL_TTL_SECONDS=900
SCAN_ENABLED=True
RETENTION_HOURS=24
CLAMAV_HOST=
CLAMAV_PORT=3310
