    "restart": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\clinova.ps1 restart -Open",
    "status": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\clinova.ps1 status",
    "health": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\clinova.ps1 health",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\clinova.ps1 doctor",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\clinova.ps1 setup"
  }
}
